NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/barivara?schema=public"

# ── JWT — REQUIRED in development and production ──────────────────────────────
# Use a cryptographically random string of at least 32 characters for each secret.
# Example: openssl rand -base64 32
JWT_ACCESS_SECRET="your-access-secret-here-replace-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-here-replace-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
MOBILE_APP_SCHEME="barivara"

# ── Supabase Storage — REQUIRED in development and production ─────────────────
# Leave empty to disable file upload features.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── File Upload Limits ────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="info"
