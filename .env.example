# ==============================================================================
# BariVara API (Backend) Environment Variables
# ==============================================================================

NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection String
# For Supabase, use the transaction pooler on port 5432 with sslmode=require
DATABASE_URL="postgresql://postgres:[YOUR_DB_USER]:[YOUR_DB_PASSWORD]@[YOUR_DB_HOST]:5432/postgres?sslmode=require"

# JWT Authentication Secrets (Must be random, secure strings of at least 32 characters in production)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-min-32-chars-long"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="30d"
JWT_REFRESH_EXPIRES_IN="60d"

# Allowed CORS Origins (Comma-separated for multiple origins)
FRONTEND_URL="http://localhost:3000,https://barivara-web.vercel.app"
MOBILE_APP_SCHEME="barivara"

# Supabase Storage Integration (for presigned file uploads)
SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Logging Level (debug, info, warn, error)
LOG_LEVEL="info"

# File Upload Size Limits
MAX_IMAGE_SIZE_MB=5
MAX_DOCUMENT_SIZE_MB=10

# Resend Email Delivery API (for sending password recovery OTPs)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM="BariVara <onboarding@resend.dev>"
